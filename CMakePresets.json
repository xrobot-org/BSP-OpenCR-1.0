{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/starm-clang.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "BootloaderDebug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "OPENCR_IMAGE": "bootloader",
                "OPENCR_LINKER_SCRIPT": "${sourceDir}/STM32F746XX_BOOTLOADER.ld"
            }
        },
        {
            "name": "AppDebug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "OPENCR_IMAGE": "app",
                "OPENCR_LINKER_SCRIPT": "${sourceDir}/STM32F746XX_APP.ld"
            }
        },
        {
            "name": "gcc",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "GccRelease",
            "inherits": "gcc"
        },
        {
            "name": "GccBootloaderRelease",
            "inherits": "gcc",
            "cacheVariables": {
                "OPENCR_IMAGE": "bootloader",
                "OPENCR_LINKER_SCRIPT": "${sourceDir}/STM32F746XX_BOOTLOADER.ld"
            }
        },
        {
            "name": "GccAppRelease",
            "inherits": "gcc",
            "cacheVariables": {
                "OPENCR_IMAGE": "app",
                "OPENCR_LINKER_SCRIPT": "${sourceDir}/STM32F746XX_APP.ld"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "BootloaderDebug",
            "configurePreset": "BootloaderDebug"
        },
        {
            "name": "AppDebug",
            "configurePreset": "AppDebug"
        },
        {
            "name": "GccRelease",
            "configurePreset": "GccRelease"
        },
        {
            "name": "GccBootloaderRelease",
            "configurePreset": "GccBootloaderRelease"
        },
        {
            "name": "GccAppRelease",
            "configurePreset": "GccAppRelease"
        }
    ]
}
